# 30 Days settings (read by ./30)
START_DATE=2026-10-30   # day 1
TOTAL_DAYS=30
BRANCH=main
# Where `./30 add` puts media: "local" (committed to the repo) or "r2" (Cloudflare R2, see r2.env.example)
MEDIA_BACKEND=local
# Local files at or above this size (MB) are refused — GitHub rejects files over 100MB. Use --r2 for those.
MAX_LOCAL_MB=90
