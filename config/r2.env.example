# Cloudflare R2 — copy this file to config/r2.env (it's gitignored) and fill it in.
# 1. Cloudflare dashboard → R2 → Create bucket (e.g. "thirty-days")
# 2. Bucket → Settings → Public access: enable the r2.dev URL (or connect a custom domain)
# 3. R2 → Manage API tokens → Create token with "Object Read & Write" on that bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=        # e.g. https://pub-xxxxxxxx.r2.dev
